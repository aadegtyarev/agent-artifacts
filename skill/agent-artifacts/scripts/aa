#!/usr/bin/env bash
# aa: command line for agent-artifacts. Needs bash and curl only.
#
# The service URL and key come from AGENT_ARTIFACTS_URL and AGENT_ARTIFACTS_KEY
# if set, otherwise from the env file written by "aa setup":
# ${AGENT_ARTIFACTS_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-artifacts/env}
set -euo pipefail

ENV_FILE=${AGENT_ARTIFACTS_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-artifacts/env}

usage() {
	cat <<'EOF'
usage: aa <command> [args]

  setup                     read AGENT_ARTIFACTS_URL=... and AGENT_ARTIFACTS_KEY=...
                            lines from stdin and save them for later calls
  upload FILE [NAME]        upload a file, print the artifact JSON (url, id, expires_at)
  replace ID FILE [NAME]    replace the file behind an existing link
  list                      your live files
  rm ID                     delete one now
  me                        your name, space used and quota, admin or not
  new-key                   replace your key (after a leak) and save the new one

admin keys only:
  users                     people with their space and last upload
  stats                     totals, free disk, limits
  invite NAME [DAYS]        a one-time link that gives NAME a key (7 days by default)
  invites                   open invites
  cancel-invite ID          cancel one
  quota NAME MB|null        NAME's own quota, or back to the common one
  remove NAME               revoke NAME's key and delete their files
  settings JSON             change limits, e.g. '{"ttl_hours": 24}'
EOF
}

die() {
	echo "aa: $*" >&2
	exit 2
}

# Reads KEY=VALUE lines without running them as shell code.
read_env_file() {
	local line
	[ -r "$ENV_FILE" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		AGENT_ARTIFACTS_URL=*) : "${AGENT_ARTIFACTS_URL:=${line#*=}}" ;;
		AGENT_ARTIFACTS_KEY=*) : "${AGENT_ARTIFACTS_KEY:=${line#*=}}" ;;
		esac
	done <"$ENV_FILE"
}

write_env_file() { # url key
	mkdir -p "$(dirname "$ENV_FILE")"
	(umask 077 && printf 'AGENT_ARTIFACTS_URL=%s\nAGENT_ARTIFACTS_KEY=%s\n' "$1" "$2" >"$ENV_FILE.tmp")
	mv "$ENV_FILE.tmp" "$ENV_FILE"
}

# call METHOD PATH [curl args...]: prints the body; exits 1 on an HTTP error.
# The key goes to curl through a config on a pipe, not the command line, so
# other users cannot see it in the process list.
call() {
	local method=$1 path=$2 out status
	shift 2
	out=$(mktemp)
	status=$(printf 'header = "Authorization: Bearer %s"\n' "$AGENT_ARTIFACTS_KEY" |
		curl -sS -K - -X "$method" -o "$out" -w '%{http_code}' "$@" \
			"${AGENT_ARTIFACTS_URL%/}$path") || {
		rm -f "$out"
		die "cannot reach $AGENT_ARTIFACTS_URL"
	}
	if [ "$status" -ge 400 ]; then
		cat "$out" >&2
		echo >&2
		rm -f "$out"
		exit 1
	fi
	cat "$out"
	rm -f "$out"
	[ "$status" = 204 ] || echo
}

json_post() { # method path json
	call "$1" "$2" -H "Content-Type: application/json" --data-binary "$3"
}

file_args() { # file [name]
	[ -f "$1" ] || die "no such file: $1"
	# Quoted, so ';' or ',' in a path is not read as a curl option.
	printf '%s\n' -F "file=@\"${1//\"/\\\"}\""
	# --form-string: a name starting with '@' or '<' is not a file to read.
	[ -z "${2:-}" ] || printf '%s\n' --form-string "name=$2"
}

cmd=${1:-}
[ -n "$cmd" ] || {
	usage
	exit 2
}
shift

if [ "$cmd" = setup ]; then
	AGENT_ARTIFACTS_URL='' AGENT_ARTIFACTS_KEY=''
	while IFS= read -r line || [ -n "$line" ]; do
		line=${line//$'\r'/}
		line=${line#export }
		case $line in
		AGENT_ARTIFACTS_URL=*) AGENT_ARTIFACTS_URL=${line#*=} ;;
		AGENT_ARTIFACTS_KEY=*) AGENT_ARTIFACTS_KEY=${line#*=} ;;
		esac
	done
	[ -n "$AGENT_ARTIFACTS_URL" ] && [ -n "$AGENT_ARTIFACTS_KEY" ] ||
		die "expected AGENT_ARTIFACTS_URL=... and AGENT_ARTIFACTS_KEY=... on stdin"
	call GET /api/v1/me >/dev/null # a wrong key or URL stops here, nothing saved
	write_env_file "$AGENT_ARTIFACTS_URL" "$AGENT_ARTIFACTS_KEY"
	echo "saved to $ENV_FILE"
	exit 0
fi

KEY_FROM_ENV=${AGENT_ARTIFACTS_KEY:+yes}
read_env_file
[ -n "${AGENT_ARTIFACTS_URL:-}" ] && [ -n "${AGENT_ARTIFACTS_KEY:-}" ] ||
	die "no key: run 'aa setup' or set AGENT_ARTIFACTS_URL and AGENT_ARTIFACTS_KEY"

API=/api/v1/artifacts
ADMIN=/api/v1/admin
case $cmd in
upload)
	[ $# -ge 1 ] || die "usage: aa upload FILE [NAME]"
	mapfile -t args < <(file_args "$@")
	call POST "$API" "${args[@]}"
	;;
replace)
	[ $# -ge 2 ] || die "usage: aa replace ID FILE [NAME]"
	id=$1
	shift
	mapfile -t args < <(file_args "$@")
	call PUT "$API/$id" "${args[@]}"
	;;
list) call GET "$API" ;;
rm)
	[ $# -eq 1 ] || die "usage: aa rm ID"
	call DELETE "$API/$1"
	;;
me) call GET /api/v1/me ;;
new-key)
	answer=$(call POST /api/v1/me/key)
	key=$(printf '%s' "$answer" | sed -n 's/.*"key": *"\([^"]*\)".*/\1/p')
	[ -n "$key" ] || die "unexpected answer"
	if [ -z "$KEY_FROM_ENV" ]; then
		write_env_file "$AGENT_ARTIFACTS_URL" "$key"
		echo "the old key no longer works; the new one is saved to $ENV_FILE"
	else
		echo "the old key no longer works; put the new one into AGENT_ARTIFACTS_KEY:"
		echo "$key"
	fi
	;;
users) call GET "$ADMIN/users" ;;
stats) call GET "$ADMIN/stats" ;;
invite)
	[ $# -ge 1 ] || die "usage: aa invite NAME [DAYS]"
	json_post POST "$ADMIN/invites" "{\"name\": \"$1\", \"days\": ${2:-7}}"
	;;
invites) call GET "$ADMIN/invites" ;;
cancel-invite)
	[ $# -eq 1 ] || die "usage: aa cancel-invite ID"
	call DELETE "$ADMIN/invites/$1"
	;;
quota)
	[ $# -eq 2 ] || die "usage: aa quota NAME MB|null"
	json_post PATCH "$ADMIN/users/$1" "{\"quota_mb\": $2}"
	;;
remove)
	[ $# -eq 1 ] || die "usage: aa remove NAME"
	call DELETE "$ADMIN/users/$1"
	;;
settings)
	[ $# -eq 1 ] || die "usage: aa settings JSON"
	json_post PATCH "$ADMIN/settings" "$1"
	;;
help | -h | --help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
